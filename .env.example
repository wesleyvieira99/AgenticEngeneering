# Development only. Never use demo identities for an internet-facing deployment.
ATLAS_MODE=deterministic
DATABASE_URL=postgresql+psycopg://atlas:atlas-local-db@localhost:54329/atlas
ATLAS_DEMO_PASSWORD=atlas-local-only
ATLAS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
ATLAS_MODEL=qwen2.5:0.5b
ATLAS_EMBEDDING_MODE=hash
ATLAS_EMBEDDING_MODEL=all-minilm
# Compose reaches the host daemon through host.docker.internal.
# For a native Python API use http://localhost:11434 instead.
ATLAS_OLLAMA_URL=http://host.docker.internal:11434
# Set only on the server, never a VITE_ or Angular environment value.
# ATLAS_LITELLM_URL=http://localhost:4000/v1
# ATLAS_LITELLM_KEY=
AWS_REGION=us-east-1
# Bedrock: set ATLAS_MODEL=amazon.nova-micro-v1:0
# Paid modes also require approved nonzero prices:
# ATLAS_PRICE_VERSION=
# ATLAS_INPUT_USD_PER_MILLION=
# ATLAS_OUTPUT_USD_PER_MILLION=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# For Langfuse use OTLP endpoint and Authorization header from a server secret.
# OTEL_EXPORTER_OTLP_HEADERS=
