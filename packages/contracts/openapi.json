  "components": {
    "schemas": {
      "DocumentInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "content": {
            "type": "string",
            "maxLength": 1048576,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "title": "DocumentInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Limits": {
        "properties": {
          "tenant_tokens": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 1.0,
            "title": "Tenant Tokens",
            "default": 100000
          },
          "tenant_cost_usd": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Tenant Cost Usd",
            "default": 10.0
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 32768.0,
            "minimum": 256.0,
            "title": "Max Tokens",
            "default": 4096
          },
          "max_output_tokens": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 64.0,
            "title": "Max Output Tokens",
            "default": 512
          },
          "max_calls": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Max Calls",
            "default": 3
          },
          "max_tools": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Max Tools",
            "default": 3
          },
          "max_steps": {
            "type": "integer",
            "maximum": 40.0,
            "minimum": 2.0,
            "title": "Max Steps",
            "default": 12
          },
          "timeout_seconds": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Timeout Seconds",
            "default": 60
          },
          "concurrency": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Concurrency",
            "default": 4
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Limits"
      },
      "Login": {
        "properties": {
          "tenant": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Tenant"
          },
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenant",
          "username",
          "password"
        ],
        "title": "Login"
      },
      "RunInput": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "baseline",
              "direct",
              "rag",
              "cag",
              "agent",
              "langgraph",
              "multiagent",
              "async"
            ],
            "title": "Strategy",
            "default": "rag"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "memory_enabled": {
            "type": "boolean",
            "title": "Memory Enabled",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "RunInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
