{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "cli": { "analytics": false },
  "projects": { "atlas": {
    "projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {
      "build": { "builder": "@angular/build:application", "options": {
        "outputPath": "dist", "index": "src/index.html", "browser": "src/main.ts",
        "tsConfig": "tsconfig.app.json", "styles": ["src/styles.css"],
        "assets": [{ "glob": "**/*", "input": "public" }],
        "budgets": [{ "type": "initial", "maximumWarning": "600kB", "maximumError": "1MB" }]
      } },
      "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "atlas:build" } }
    }
  } }
}
